# Salin file ini jadi .env lalu isi sesuai lingkungan masing-masing.
# URL API backend tanpa garis miring di akhir. Di produksi isi URL API di Render.
VITE_API_URL=http://localhost:3000

# Tampilkan tombol tambah, edit, dan hapus di UI.
# Untuk deploy produksi publik, atur ke false (mode hanya-baca).
VITE_ENABLE_EDIT=true
