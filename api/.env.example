# Salin file ini jadi .env lalu isi nilai sesuai lingkungan masing-masing.
# Connection string dari dashboard Neon (wajib menggunakan sslmode=require)
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Port HTTP API
PORT=3000

# Daftar asal frontend yang diizinkan (pisahkan dengan koma tanpa spasi).
# Di lokal: http://localhost:5173
# Di produksi: https://nama-app.vercel.app
CORS_ORIGIN=http://localhost:5173

# Mengizinkan endpoint tulis (POST, PUT, DELETE).
# Untuk deploy produksi publik, atur ke false agar database aman dari perubahan luar.
ALLOW_WRITE=true
